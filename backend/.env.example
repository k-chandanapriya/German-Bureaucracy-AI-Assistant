# Copy to .env and fill in. Without an AI provider you can still try the sample letters.

# Who reads your letters:
#   ollama    = a local model on this computer (free, nothing leaves your machine)
#   groq      = a free hosted model on Groq (needs a free GROQ_API_KEY from console.groq.com)
#   anthropic = Claude via the Anthropic API (needs ANTHROPIC_API_KEY, best accuracy)
AI_PROVIDER=ollama

# --- Local model (Ollama, https://ollama.com) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
OLLAMA_TIMEOUT_S=300

# --- Free hosted model (Groq, or any OpenAI-compatible API) ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Claude (Anthropic API) ---
ANTHROPIC_API_KEY=
# Claude Sonnet reads most letters; low-confidence letters are re-read by Claude Opus.
EXTRACTION_MODEL=claude-sonnet-5-5
ESCALATION_MODEL=claude-opus-5-5
ESCALATION_THRESHOLD=0.7
# SQLite locally; use a Postgres URL (e.g. Supabase, EU region) in production.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/amtspost
DEFAULT_BUNDESLAND=BE
CORS_ORIGINS=http://localhost:3000
